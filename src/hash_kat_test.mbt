// Independent expected outputs from Python hashlib (OpenSSL SHA-3/SHAKE).
// Reference values are printed by tools/hash_vectors.py, which does not use moonkem.

///|
test "sha3_256/empty/independent vector" {
  let message : Array[Byte] = []
  let expected : Array[Byte] = [
    167, 255, 198, 248, 191, 30, 215, 102, 81, 193, 71, 86, 160, 97, 214, 98, 245,
    128, 255, 77, 228, 59, 73, 250, 130, 216, 10, 75, 128, 248, 67, 74,
  ]
  assert_eq(@moonkem.sha3_256(message), expected)
}

